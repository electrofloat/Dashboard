{
  'app_config': {
    'required' : False,
    'nullable': False,
    'type' : 'dict',
    'schema': {
      'authelia_url': {
        'required': False,
        'type': 'string',
        'regex':'^http.*'
      },
      'background': {
        'required': False,
        'type': 'string'
      },
      'settings': {
        'required': False,
        $listoflists
      }
    }
  },
  'network': {
    'required': False,
    'nullable': False,
    'type': 'dict',
    'allow_unknown': True,
    'schema': {
      'no': {
        'required': False,
        'type':'list',
        'minlength': 1,
        'schema':{
          'type':'string'
        }
      }
    }
  },
  'tiles':{
    'required':True,
    'type':'list',
    'minlength': 1,
    'schema': {
      'type':'dict',
      'schema':{
        'title':{
          'required':True,
          'type':'string'
        },
        'description':{
          'required':False,
          'type':'string'
        },
        'icon':{
          'required':False,
          'type':'string',
        },
        'background':{
          'required':False,
          'type':'string',
          'regex':'^#(?:[0-9a-fA-F]{3}){1,2}$$'
        },
        'url':{
          'required':True,
          'type':'string',
          'regex':'^http.*'
        },
        'allow':{
          'excludes':'deny',
          $listoflists
        },
        'deny':{
          'excludes':'allow',
          $listoflists
        },
        'networks': {
          'required': False,
          'nullable': False,
          'type':'list',
          'minlength': 1,
          'schema':{
            'type':'string'
          },
          'anyof':[
            {'dependencies' : 'allow'},
            {'dependencies' : 'deny'}
          ]
        }
      }
    }
  }
}
