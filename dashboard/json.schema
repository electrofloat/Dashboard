{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",

  "$defs": {
    "listoflists": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(user:|group:).*"
            }
          },
          {
            "type": "string",
            "pattern": "^(user:|group:).*"
          }
        ]
      }
    },

    "tile": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "const": "tile" },
            "title": { "type": "string" },
            "description": { "type": "string" },
            "icon": { "type": "string" },
            "background": {
              "type": "string",
              "pattern": "^#(?:[0-9a-fA-F]{3}){1,2}$"
            },
            "url": {
              "type": "string",
              "pattern": "^http.*"
            },
            "allow": { "$ref": "#/$defs/listoflists" },
            "deny": { "$ref": "#/$defs/listoflists" },
            "networks": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            }
          },
          "required": ["type", "title", "url"],
          "additionalProperties": false,
          "allOf": [
            { "not": { "required": ["allow", "deny"] } },
            {
              "if": { "required": ["networks"] },
              "then": { "anyOf": [{ "required": ["allow"] }, { "required": ["deny"] }] }
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "folder" },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "title": { "type": "string" },
            "description": { "type": "string" },
            "icon": { "type": "string" },
            "background": {
              "type": "string",
              "pattern": "^#(?:[0-9a-fA-F]{3}){1,2}$"
            },
            "tiles": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/tile" }
            }
          },
          "required": ["type", "title", "tiles"],
          "additionalProperties": false
        }
      ]
    }
  },

  "properties": {
    "app_config": {
      "type": "object",
      "properties": {
        "authelia_url": {
          "type": "string",
          "pattern": "^http.*"
        },
        "authelia_timeout": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "authelia_cookie_name": { "type": "string", "minLength": 1 },
        "authelia_cache_ttl": {
          "type": "integer",
          "minimum": 0
        },
        "authelia_backoff": {
          "type": "integer",
          "minimum": 0
        },
        "trusted_proxies": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "background": { "type": "string" },
        "settings": { "$ref": "#/$defs/listoflists" }
      },
      "additionalProperties": false
    },

    "network": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string" }
      }
    },

    "tiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tile" }
    }
  },

  "required": ["tiles"],
  "additionalProperties": false
}
